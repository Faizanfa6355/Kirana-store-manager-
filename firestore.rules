rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if current user is the designated admin
    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email == 'fa635588@gmail.com') ||
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    // Helper to verify the user owns the document by Firebase UID or is admin
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile: owners can read/write their own profile; admin can read/manage all user profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Store data: products, sales, purchases, customers, suppliers, expenses, settings, creditTransactions
    match /stores/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
