rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to verify the user owns the document by Firebase UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile: strictly isolated by UID
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Store data: products, sales, purchases, customers, suppliers, expenses, settings, creditTransactions
    match /stores/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /{subcollection}/{docId}/{subPath=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
